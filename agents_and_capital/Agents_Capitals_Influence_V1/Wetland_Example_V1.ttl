@prefix aci: <https://www.michaeldebellis.com/agents_capitals_influence/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/aci-wetland/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pplan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/aci-wetland> a owl:Ontology ;
    rdfs:label "Fictional wetland restoration example"@en ;
    dcterms:description "Entirely synthetic demonstration. No actor, interview, date, resource, or influence statement in this file is an empirical claim. The two contrasting community assessments demonstrate differing viewpoints."@en ;
    owl:imports <https://www.michaeldebellis.com/agents_capitals_influence> .

ex:Community_Delay_Account a owl:NamedIndividual,
        aci:Influence_Assessment ;
    rdfs:label "Community Delay Account"@en ;
    rdfs:comment "Fictional authority perspective: the same discussion delays coordination. A distinct assessment preserves this differing viewpoint."@en ;
    aci:appliesFrom "2026-09-01T00:00:00+00:00"^^xsd:dateTime ;
    aci:appliesUntil "2026-10-01T00:00:00+00:00"^^xsd:dateTime ;
    aci:assessedActor ex:Community_Network ;
    aci:assessedAt "2026-09-20T12:00:00+00:00"^^xsd:dateTime ;
    aci:assessedBy ex:Analyst ;
    aci:assessedCapital ex:Community_Trust ;
    aci:basedOnEvidence ex:Synthetic_Authority_Interview ;
    aci:hasAgencyForm aci:Steering_Social_Ecological_Discourse ;
    aci:hasAssessmentStatus aci:Illustrative ;
    aci:hasDirection aci:Constraining ;
    aci:inContextOf ex:Wetland_Context ;
    aci:influenceTarget ex:Coordination_Activity ;
    aci:perspectiveOf ex:Regional_Authority .

ex:Community_Support_Account a owl:NamedIndividual,
        aci:Influence_Assessment ;
    rdfs:label "Community Support Account"@en ;
    rdfs:comment "Fictional cooperative perspective: community discussion improves engagement."@en ;
    aci:appliesFrom "2026-09-01T00:00:00+00:00"^^xsd:dateTime ;
    aci:appliesUntil "2026-10-01T00:00:00+00:00"^^xsd:dateTime ;
    aci:assessedActor ex:Community_Network ;
    aci:assessedAt "2026-09-20T12:00:00+00:00"^^xsd:dateTime ;
    aci:assessedBy ex:Analyst ;
    aci:assessedCapital ex:Community_Trust,
        ex:Wetland_Knowledge_Tradition ;
    aci:basedOnEvidence ex:Synthetic_Cooperative_Interview ;
    aci:hasAgencyForm aci:Steering_Social_Ecological_Discourse ;
    aci:hasAssessmentStatus aci:Illustrative ;
    aci:hasDirection aci:Enabling ;
    aci:inContextOf ex:Wetland_Context ;
    aci:influenceTarget ex:Coordination_Activity ;
    aci:perspectiveOf ex:Restoration_Cooperative .

ex:Discourse_Capacity a owl:NamedIndividual,
        aci:Agency ;
    rdfs:label "Discourse Capacity — fictional"@en ;
    aci:agencyOf ex:Community_Network ;
    aci:hasAgencyForm aci:Steering_Social_Ecological_Discourse ;
    aci:hasCapitalBasis ex:Community_Trust,
        ex:Wetland_Knowledge_Tradition ;
    aci:inContextOf ex:Wetland_Context .

ex:Equipment_Capacity a owl:NamedIndividual,
        aci:Agency ;
    rdfs:label "Equipment Capacity — fictional"@en ;
    aci:agencyOf ex:Restoration_Cooperative ;
    aci:hasAgencyForm aci:Providing_Physical_Goods_And_Assets ;
    aci:hasCapitalBasis ex:Survey_Equipment ;
    aci:inContextOf ex:Wetland_Context .

ex:Equipment_Link a owl:NamedIndividual,
        aci:Influence_Assessment ;
    rdfs:label "Equipment Link"@en ;
    rdfs:comment "Illustrative actor-to-process link. Together with Funding_Link it creates a candidate indirect path, not proof of a causal effect."@en ;
    aci:appliesFrom "2026-09-01T00:00:00+00:00"^^xsd:dateTime ;
    aci:appliesUntil "2026-10-01T00:00:00+00:00"^^xsd:dateTime ;
    aci:assessedActor ex:Restoration_Cooperative ;
    aci:assessedAt "2026-09-20T12:00:00+00:00"^^xsd:dateTime ;
    aci:assessedBy ex:Analyst ;
    aci:assessedCapital ex:Survey_Equipment ;
    aci:basedOnEvidence ex:Synthetic_Workshop_Notes ;
    aci:hasAgencyForm aci:Providing_Physical_Goods_And_Assets ;
    aci:hasAssessmentStatus aci:Illustrative ;
    aci:hasDirection aci:Enabling ;
    aci:inContextOf ex:Wetland_Context ;
    aci:influenceTarget ex:Coordination_Activity ;
    aci:perspectiveOf ex:Restoration_Cooperative .

ex:Funding_Access_After_Approval a owl:NamedIndividual,
        aci:Capital_Access_Assessment ;
    rdfs:label "Funding Access After Approval"@en ;
    aci:appliesFrom "2026-09-10T00:00:00+00:00"^^xsd:dateTime ;
    aci:appliesUntil "2026-10-01T00:00:00+00:00"^^xsd:dateTime ;
    aci:assessedActor ex:Restoration_Cooperative ;
    aci:assessedAt "2026-09-20T12:00:00+00:00"^^xsd:dateTime ;
    aci:assessedBy ex:Analyst ;
    aci:assessedCapital ex:Restoration_Fund ;
    aci:basedOnEvidence ex:Synthetic_Workshop_Notes ;
    aci:hasAccessStatus aci:Available ;
    aci:hasAssessmentStatus aci:Illustrative ;
    aci:inContextOf ex:Wetland_Context .

ex:Funding_Access_Before_Approval a owl:NamedIndividual,
        aci:Capital_Access_Assessment ;
    rdfs:label "Funding Access Before Approval"@en ;
    aci:appliesFrom "2026-09-01T00:00:00+00:00"^^xsd:dateTime ;
    aci:appliesUntil "2026-09-10T00:00:00+00:00"^^xsd:dateTime ;
    aci:assessedActor ex:Restoration_Cooperative ;
    aci:assessedAt "2026-09-20T12:00:00+00:00"^^xsd:dateTime ;
    aci:assessedBy ex:Analyst ;
    aci:assessedCapital ex:Restoration_Fund ;
    aci:basedOnEvidence ex:Synthetic_Workshop_Notes ;
    aci:hasAccessStatus aci:Restricted ;
    aci:hasAssessmentStatus aci:Illustrative ;
    aci:inContextOf ex:Wetland_Context .

ex:Funding_Link a owl:NamedIndividual,
        aci:Influence_Assessment ;
    rdfs:label "Funding Link"@en ;
    rdfs:comment "Illustrative actor-to-actor link: authority funding supports the cooperative. This is a qualified claim, not an asserted transitive influence edge."@en ;
    aci:appliesFrom "2026-09-01T00:00:00+00:00"^^xsd:dateTime ;
    aci:appliesUntil "2026-10-01T00:00:00+00:00"^^xsd:dateTime ;
    aci:assessedActor ex:Regional_Authority ;
    aci:assessedAt "2026-09-20T12:00:00+00:00"^^xsd:dateTime ;
    aci:assessedBy ex:Analyst ;
    aci:assessedCapital ex:Restoration_Fund ;
    aci:basedOnEvidence ex:Synthetic_Workshop_Notes ;
    aci:describesExercise ex:Funding_Decision ;
    aci:hasAgencyForm aci:Influencing_Financial_Flows ;
    aci:hasAssessmentStatus aci:Illustrative ;
    aci:hasDirection aci:Enabling ;
    aci:inContextOf ex:Wetland_Context ;
    aci:influenceTarget ex:Restoration_Cooperative ;
    aci:perspectiveOf ex:Restoration_Cooperative .

ex:Political_Capacity a owl:NamedIndividual,
        aci:Agency ;
    rdfs:label "Political Capacity — fictional"@en ;
    aci:agencyOf ex:Regional_Authority ;
    aci:hasAgencyForm aci:Enacting_Political_Relevance ;
    aci:hasCapitalBasis ex:Permitting_Mandate ;
