<https://www.michaeldebellis.com/iucn> rdf:type owl:Ontology ; 
  dcterms:creator "Michael DeBellis" ; 
  dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/> ; 
  dcterms:rights "Copyright © 2026 Michael DeBellis. This ontology draft is licensed under Creative Commons Attribution-NonCommercial 4.0 International (CC BY-NC 4.0), except where third-party terms apply. Portions of labels, definitions, terminology, and conceptual structure are adapted from Keith, D.A., Ferrer-Paris, J.R., Nicholson, E. and Kingsford, R.T. (eds.) (2020), The IUCN Global Ecosystem Typology 2.0: Descriptive profiles for biomes and ecosystem functional groups, DOI: https://doi.org/10.2305/IUCN.CH.2020.13.en. IUCN-derived material is included with acknowledgment for educational and non-commercial purposes. Commercial use may require permission from IUCN and/or other rights holders. Reused ontology foundations, including SULO/Big_Bro/PROV/SKOS/DCTERMS components, remain subject to their respective original licenses and notices."@en ; 
  dcterms:source <https://doi.org/10.2305/IUCN.CH.2020.13.en> ; 
  dcterms:title "IUCN Global Ecosystem Typology Ontology Draft"@en ; 
  rdfs:comment "Independent draft ontology for exploring the IUCN Global Ecosystem Typology in OWL. This is not an official IUCN ontology."@en ; 
  rdfs:label "IUCN Global Ecosystem Typology Ontology Draft"@en ; 
  skos:historyNote """Metadata from ontologies reused here:

dc:creator <https://orcid.org/0000-0003-4727-9435> ;
                                        dcterms:alternative \"SULO\"@en ;
                                        dcterms:bibliographicCitation \"Michel Dumontier, Remzi Çelebi, Komal Gilani, Isabelle de Zegher, Katerina Serafimova, Catalina Martínez Costa and Stefan Schulz. SULO - a simplified upper-level ontology. Proceedings of the Joint Ontology Workshops (JOWO) - Episode XI: The Sicilian Summer under the Etna, co-located with the 15th International Conference on Formal Ontology in Information Systems (FOIS 2025), September 8-9, 2025, Catania, Italy\"@en ;
                                        dcterms:contributor <https://orcid.org/0000-0001-7222-3287> ,
                                                            \"Michael DeBellis Orcid ID: 0000-0002-8824-9577\"@en ;
                                        dcterms:created \"2024-11-11\" ,
                                                        \"2025-28-11\" ;
                                        dcterms:description \"Basic_Bro  provides core metadata annotation properties by reusing SKOS and DCTERMS. It is the foundational module used by all BRO layers and includes only annotation and datatype properties, with no classes or object properties.\"@en ;
                                        dcterms:issued \"2025-07-11\" ;
                                        dcterms:language <http://lexvo.org/id/iso639-1/en> ;
                                        dcterms:license <https://creativecommons.org/publicdomain/zero/1.0> ,
                                                        <https://www.apache.org/licenses/LICENSE-2.0> ;
                                        dcterms:modified \"2025-11-20\"^^xsd:date ;
                                        dcterms:publisher <https://orcid.org/0000-0003-4727-9435> ;
                                        dcterms:title \"Basic Reusable Ontology 1 big_bro\"@en ,
                                                      \"Simplified Upper Level Ontology\"@en ;
                                        <http://purl.org/pav/authoredBy> <https://orcid.org/0000-0003-4727-9435> ;
                                        <http://purl.org/vocab/vann/preferredNamespacePrefix> \"sulo\" ;
                                        <http://purl.org/vocab/vann/preferredNamespaceUri> <https://w3id.org/sulo/> ;
                                        rdfs:comment \"Subset of the W3C PROV-O ontology containing only the terms needed by the Basic Reusable Ontology (Big Bro). IRIs of PROV terms are preserved; content not required by Big Bro has been omitted.\"@en ,
                                                     \"The Simplified Upper Level Ontology (SULO) is ontology with a minimal set of classes and relations to guide the development of a personal health knowledge graph.\"@en ;
                                        rdfs:label \"Simplified Upper Level Ontology\"@en ;
                                        rdfs:seeAlso <http://www.w3.org/TR/prov-o/> ,
                                                     <http://www.w3.org/ns/prov> ;
                                        owl:backwardCompatibleWith <https://w3id.org/sulo/sulo-0.2.3.ttl> ;
                                        owl:priorVersion <https://w3id.org/sulo/sulo-0.2.3.ttl> ;
                                        owl:versionInfo \"Recommendation version 2013-04-30, subsetted as PROV-Lite for Big Bro\"@en ,
                                                        \"0.2.9\" ,
                                                        \"1.0.0\" ;
                                        skos:changeNote \"\"\"2025-11-29 (M. DeBellis): Created PROV-Lite as a cleaned subset of the W3C PROV-O Turtle serialization for use with the Basic Reusable Ontology (Big Bro).
– Removed duplicate owl:Ontology declarations.
– Moved orphaned ontology metadata triples (label, seeAlso, versionIRI, versionInfo, specializationOf, wasRevisionOf) under this ontology IRI.
– Removed stray non-comment prose that appeared after the :wasStartedBy axiom and caused Turtle parse errors.
– Trimmed PROV terms and axioms not required by Big Bro, without changing the IRIs or logical meaning of the retained PROV terms.\"\"\"@en ,
                                                        \"\"\"enImported SULO upper model: https://w3id.org/sulo/
December 17, 2025
Michael DeBellis\"\"\" ;
                                        skos:editorialNote \"Basic_Bro includes the legacy Dublin Core (dc:) namespace only because it is automatically imported by DCTERMS for backward compatibility. BRO users should always use dcterms:* properties and never use dc:* properties.\"@en ;
                                        skos:note \"Basic_Bro reuses annotation and datatype properties from the SKOS and DCTERMS vocabularies. All classes and object properties from imported vocabularies have been removed to provide a clean metadata-only reusable layer.\"@en ;
                                        <http://www.w3.org/ns/dcat#accessURL> <https://w3id.org/sulo/sulo.ttl> ;
                                        foaf:homepage <https://github.com/AIDAVA-DEV/sulo> ;
                                        <https://schema.org/funding> \"This work is partially supported by the AIDAVA project (GA 101057062), as part of the European Union's Horizon Europe research and innovation programme.\"@en ;"""@en . 
